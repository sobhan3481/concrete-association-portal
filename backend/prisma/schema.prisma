generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  MEMBER
  ASSOCIATION_ADMIN
  SYSTEM_ADMIN
}

enum MemberType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum ProfileStatus {
  INCOMPLETE
  COMPLETE
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CompanyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LandOwnershipType {
  OWNED
  RENTED
  PARTNERSHIP
  OTHER
}

enum BatchingPlantType {
  WET
  DRY
  HYBRID
}

enum CementPurchaseSource {
  COMMODITY_EXCHANGE
  FREE_MARKET
  MIXED
}

enum OperationalStatus {
  ACTIVE
  SEMI_ACTIVE
  INACTIVE
}

model User {
  id               String          @id @default(cuid())
  username         String          @unique
  fullName         String
  mobileNumber     String          @unique
  passwordHash     String
  isMobileVerified Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userRoles        UserRole[]
  refreshTokens    RefreshToken[]
  memberProfile    MemberProfile?
  companyProfile   CompanyProfile?
  ownedFactories   Factory[]
}

model Role {
  id        String     @id @default(cuid())
  name      SystemRole @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userRoles UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model OtpRequest {
  id           String    @id @default(cuid())
  mobileNumber String
  otpHash      String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([mobileNumber])
}

model MobileVerification {
  id           String   @id @default(cuid())
  mobileNumber String   @unique
  verifiedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  target    String
  metadata  Json
  ipAddress String?
  createdAt DateTime @default(now())
}

model MemberProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  memberType      MemberType
  fullName        String
  nationalCode    String?
  positionTitle   String?
  profileStatus   ProfileStatus   @default(INCOMPLETE)
  approvalStatus  ApprovalStatus  @default(PENDING_REVIEW)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfile  CompanyProfile?

  @@index([approvalStatus])
}

model CompanyProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  memberProfileId    String?        @unique
  companyName        String
  brandName          String?
  nationalId         String?
  registrationNumber String?
  phone              String?
  province           String
  city               String
  address            String
  postalCode         String?
  logoUrl            String?
  description        String?
  companyStatus      CompanyStatus  @default(DRAFT)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile? @relation(fields: [memberProfileId], references: [id], onDelete: SetNull)
  factories          Factory[]

  @@index([companyStatus])
}

model Factory {
  id                        String               @id @default(cuid())
  companyProfileId          String
  ownerUserId               String
  name                      String
  province                  String
  city                      String
  address                   String
  landAreaSqm               Decimal?             @db.Decimal(12, 2)
  landOwnershipType         LandOwnershipType
  monthlyRentAmount         Decimal?             @db.Decimal(12, 2)
  batchingPlantCount        Int?
  batchingPlantType         BatchingPlantType?
  batchingPlantBrand        String?
  dailyProductionCapacityM3 Decimal?             @db.Decimal(12, 2)
  cementSiloCount           Int?
  cementSiloCapacityTons    Decimal?             @db.Decimal(12, 2)
  hasWaterWell              Boolean              @default(false)
  hasLaboratory             Boolean              @default(false)
  hasWeighbridge            Boolean              @default(false)
  cementPurchaseSource      CementPurchaseSource @default(MIXED)
  operationalStatus         OperationalStatus    @default(ACTIVE)
  notes                     String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  companyProfile            CompanyProfile       @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  ownerUser                 User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([companyProfileId])
  @@index([ownerUserId])
}
