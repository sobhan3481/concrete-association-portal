generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  MEMBER
  ASSOCIATION_ADMIN
  SYSTEM_ADMIN
}

enum MemberType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum ProfileStatus {
  INCOMPLETE
  COMPLETE
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CompanyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LandOwnershipType {
  OWNED
  RENTED
  PARTNERSHIP
  OTHER
}

enum BatchingPlantType {
  WET
  DRY
  HYBRID
}

enum CementPurchaseSource {
  COMMODITY_EXCHANGE
  FREE_MARKET
  MIXED
}

enum OperationalStatus {
  ACTIVE
  SEMI_ACTIVE
  INACTIVE
}

enum MachineryType {
  LOADER
  MIXER
  DUMP_TRUCK
  STATIONARY_PUMP
  BOOM_PUMP
}

enum MachineryOwnershipType {
  OWNED
  RENTED
  LEASED
  OTHER
}

enum MaterialType {
  CEMENT
  COARSE_AGGREGATE
  FINE_AGGREGATE
  WATER
  ADMIXTURE
  GEL
  POZZOLAN
  SLAG
  OTHER
}

enum MaterialUnit {
  KG
  TON
  LITER
  CUBIC_METER
  UNIT
}

enum MaterialPurchaseSource {
  COMMODITY_EXCHANGE
  FREE_MARKET
  DIRECT_SUPPLIER
  INTERNAL
  OTHER
}

model User {
  id               String          @id @default(cuid())
  username         String          @unique
  fullName         String
  mobileNumber     String          @unique
  passwordHash     String
  isMobileVerified Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userRoles        UserRole[]
  refreshTokens    RefreshToken[]
  memberProfile    MemberProfile?
  companyProfile   CompanyProfile?
  ownedFactories   Factory[]
  ownedMachinery   Machinery[]
  ownedMaterials   Material[]
  ownedMixDesigns  MixDesign[]
}

model Role {
  id        String     @id @default(cuid())
  name      SystemRole @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userRoles UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model OtpRequest {
  id           String    @id @default(cuid())
  mobileNumber String
  otpHash      String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([mobileNumber])
}

model MobileVerification {
  id           String   @id @default(cuid())
  mobileNumber String   @unique
  verifiedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  target    String
  metadata  Json
  ipAddress String?
  createdAt DateTime @default(now())
}

model MemberProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  memberType      MemberType
  fullName        String
  nationalCode    String?
  positionTitle   String?
  profileStatus   ProfileStatus   @default(INCOMPLETE)
  approvalStatus  ApprovalStatus  @default(PENDING_REVIEW)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfile  CompanyProfile?

  @@index([approvalStatus])
}

model CompanyProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  memberProfileId    String?        @unique
  companyName        String
  brandName          String?
  nationalId         String?
  registrationNumber String?
  phone              String?
  province           String
  city               String
  address            String
  postalCode         String?
  logoUrl            String?
  description        String?
  companyStatus      CompanyStatus  @default(DRAFT)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile? @relation(fields: [memberProfileId], references: [id], onDelete: SetNull)
  factories          Factory[]

  @@index([companyStatus])
}

model Factory {
  id                        String               @id @default(cuid())
  companyProfileId          String
  ownerUserId               String
  name                      String
  province                  String
  city                      String
  address                   String
  landAreaSqm               Decimal?             @db.Decimal(12, 2)
  landOwnershipType         LandOwnershipType
  monthlyRentAmount         Decimal?             @db.Decimal(12, 2)
  batchingPlantCount        Int?
  batchingPlantType         BatchingPlantType?
  batchingPlantBrand        String?
  dailyProductionCapacityM3 Decimal?             @db.Decimal(12, 2)
  cementSiloCount           Int?
  cementSiloCapacityTons    Decimal?             @db.Decimal(12, 2)
  hasWaterWell              Boolean              @default(false)
  hasLaboratory             Boolean              @default(false)
  hasWeighbridge            Boolean              @default(false)
  cementPurchaseSource      CementPurchaseSource @default(MIXED)
  operationalStatus         OperationalStatus    @default(ACTIVE)
  notes                     String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  companyProfile            CompanyProfile       @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  ownerUser                 User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  machinery                 Machinery[]
  materials                 Material[]
  mixDesigns                MixDesign[]

  @@index([companyProfileId])
  @@index([ownerUserId])
}

model Machinery {
  id                          String                 @id @default(cuid())
  factoryId                   String
  ownerUserId                 String
  machineryType               MachineryType
  ownershipType               MachineryOwnershipType
  title                       String
  quantity                    Int
  brand                       String?
  model                       String?
  manufactureYear             Int?
  capacityValue               Decimal?               @db.Decimal(12, 2)
  capacityUnit                String?
  boomLengthMeters            Decimal?               @db.Decimal(12, 2)
  monthlyRentAmount           Decimal?               @db.Decimal(12, 2)
  depreciationMonthlyAmount   Decimal?               @db.Decimal(12, 2)
  fuelCostMonthly             Decimal?               @db.Decimal(12, 2)
  maintenanceCostMonthly      Decimal?               @db.Decimal(12, 2)
  driverOrOperatorCostMonthly Decimal?               @db.Decimal(12, 2)
  isActive                    Boolean                @default(true)
  notes                       String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  factory                     Factory                @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  ownerUser                   User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([ownerUserId])
  @@index([machineryType])
}


model Material {
  id             String                 @id @default(cuid())
  factoryId      String
  ownerUserId    String
  materialType   MaterialType
  name           String
  unit           MaterialUnit
  unitPrice      Decimal                @db.Decimal(12, 2)
  supplierName   String?
  purchaseSource MaterialPurchaseSource?
  isActive       Boolean                @default(true)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  factory        Factory                @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  ownerUser      User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  mixDesignItems MixDesignItem[]

  @@index([factoryId])
  @@index([ownerUserId])
  @@index([materialType])
}

model MixDesign {
  id                      String          @id @default(cuid())
  factoryId               String
  ownerUserId             String
  title                   String
  concreteGrade           Int
  resistanceClass         String?
  slumpMm                 Int?
  targetStrengthMpa       Decimal?        @db.Decimal(12, 2)
  wasteFactorPercent      Decimal         @default(0) @db.Decimal(8, 2)
  labCostPerM3            Decimal         @default(0) @db.Decimal(12, 2)
  directMaterialCostPerM3 Decimal         @default(0) @db.Decimal(12, 2)
  calculatedCostPerM3     Decimal         @default(0) @db.Decimal(12, 2)
  isActive                Boolean         @default(true)
  notes                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  factory                 Factory         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  ownerUser               User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  items                   MixDesignItem[]

  @@index([factoryId])
  @@index([ownerUserId])
  @@index([concreteGrade])
}

model MixDesignItem {
  id                String       @id @default(cuid())
  mixDesignId       String
  materialId        String
  quantity          Decimal      @db.Decimal(12, 3)
  unit              MaterialUnit
  unitPriceSnapshot Decimal      @db.Decimal(12, 2)
  totalCost         Decimal      @db.Decimal(12, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  mixDesign         MixDesign    @relation(fields: [mixDesignId], references: [id], onDelete: Cascade)
  material          Material     @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([mixDesignId])
  @@index([materialId])
}
