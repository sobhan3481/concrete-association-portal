{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=concrete_association;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "ConcreteAssociation",
    "Audience": "ConcreteAssociationUsers",
    "SecretKey": "ChangeMe_AtLeast32Characters_Long_Key",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/auth/request-otp",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "1m",
        "Limit": 5
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
